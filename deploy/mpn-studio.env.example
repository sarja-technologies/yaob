# MPN Studio environment. Copy to deploy/mpn-studio.env and adjust the paths. No secrets belong here:
# the API and UI are reachable only from the networks in MPN_ALLOWED_NETS (default: this machine only).
MPN_DATA=/srv/yaob/data
MPN_DB=/srv/yaob/data/yaob-n10k.sqlite
MPN_MODELS=/srv/yaob/models
MPN_WEB=/srv/yaob/web-dist
MPN_CORE=Qwen3-4B-Instruct-2507
MPN_ENCODER=Qwen3-Embedding-0.6B
MPN_HOST=127.0.0.1
MPN_PORT=8840
MPN_RUNTIME_URL=http://127.0.0.1:8841
MPN_RUNTIME_PORT=8841
# Add your LAN to reach the UI from other machines, e.g. 127.0.0.0/8,::1/128,192.168.1.0/24
MPN_ALLOWED_NETS=127.0.0.0/8,::1/128
# Optional: an advisory lock file shared with other GPU work on the machine (see mpnstudio/train/gpulock.py).
# MPN_GPU_LOCK=/path/to/gpu.lock
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONUNBUFFERED=1
